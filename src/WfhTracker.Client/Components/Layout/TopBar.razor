        <div class="flex h-24 w-24 items-center justify-center rounded">
            <img src="images/logo.png" alt="WFH Tracker" class="profile-icon" />
        </div>

        <!-- Title and subtitle -->
        <div>
            <h1 class="text-lg font-bold text-white">WFH Tracker - BETA</h1>
