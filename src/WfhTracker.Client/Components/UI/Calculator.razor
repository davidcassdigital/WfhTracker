@inject EntryService entryService
@inject EntryService entryService
@inject IJSRuntime JSRuntime

<div>
    <h2 class="mb-6 text-xl font-semibold text-white">
        Working from Home Deduction Calculator
    </h2>

    <div class="flex flex-col gap-4">
        <!-- Financial Year Selector -->
        <div>
            <label class="mb-2 block text-sm font-medium text-zinc-400">
                Financial Year
            </label>
            <select @onchange="OnFinancialYearChanged" class="w-full rounded-md border border-zinc-600 bg-zinc-700 px-3 py-2 text-white focus:border-amber-600 focus:outline-none">
                @foreach (var fy in FinancialYears)
                {
                    <option value="@fy">@fy</option>
                }
            </select>
        </div>

        <!-- Rate -->
        <div>
            <label class="mb-2 block text-sm font-medium text-zinc-400">
                Fixed Rate per Hour
            </label>
            <div class="relative">
                <span class="absolute px-2 py-2 text-white">$</span>
                <input type="number" @bind="rate" step="0.01" min="0" class="w-full rounded-md border border-zinc-600 bg-zinc-700 px-4 py-2 pr-1 pl-7 text-white focus:border-amber-600 focus:outline-none" placeholder="0.00" />
            </div>
        </div>

        <!-- Calculate Button -->
        <button @onclick="CalculateTotalAsync" class="rounded-md bg-amber-600 px-4 py-2 font-medium text-white transition-colors hover:bg-amber-700">
            Calculate Deduction
        </button>

        <!-- Results Display -->
        @if (calculationResult.HasValue && totalHours.HasValue)
        {
            <div class="mt-4 space-y-3">
                <!-- Total Hours -->
                <div class="rounded-md bg-zinc-700 p-4 text-center">
                    <p class="text-sm text-zinc-400">Eligible Hours Worked from Home</p>
                    <p class="text-2xl font-semibold text-blue-400">
                        @totalHours.Value.ToString("F1") hours
                    </p>
                </div>

                <!-- Total Earnings -->
                <div class="rounded-md bg-zinc-700 p-4 text-center">
                    <p class="text-sm text-zinc-400">Estimated Deduction</p>
                    <p class="text-3xl font-semibold text-amber-400">
                        @calculationResult.Value.ToString("C2")
                    </p>
                </div>

                <!-- Description to Copy -->
                <div class="rounded-md bg-zinc-700 p-4">
                    <p class="mb-2 text-sm text-zinc-400">Summary</p>
                    <div class="flex gap-2">
                        <div class="flex-1 rounded-md bg-zinc-600 px-3 py-2 text-sm break-words text-white">
                            @GetDescription()
                        </div>
                        <button @onclick="CopyToClipboard" class="rounded-md bg-blue-600 px-3 py-2 font-medium whitespace-nowrap text-white transition-colors hover:bg-blue-700">
                            Copy
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>


}
