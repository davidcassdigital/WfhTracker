<div>
    <h2 class="text-xl font-semibold text-white mb-6">
        Calculator
    </h2>

    <div class="flex flex-col gap-2">
        <!-- Display -->
        <div class="bg-zinc-700 text-amber-400 p-4 rounded-md text-right text-3xl font-semibold min-h-[60px] flex items-center justify-end break-words">
            @display
        </div>

        <!-- Buttons Grid -->
        <div class="grid grid-cols-4 gap-2">
</div>
    </div>
</div>

@code {
    private string display = "0";
    private double result = 0;
    private string currentOperator = "";
    private bool operatorPressed = false;

    private void AppendNumber(string number)
    {
        if (operatorPressed)
        {
            display = number;
            operatorPressed = false;
        }
        else
        {
            display = display == "0" ? number : display + number;
        }
    }

    private void AppendOperator(string op)
    {
        if (!operatorPressed && double.TryParse(display, out double num))
        {
            if (currentOperator != "")
            {
                Calculate();
            }
            else
            {
                result = num;
            }
            currentOperator = op;
            operatorPressed = true;
        }
    }

    private void Calculate()
    {
        if (currentOperator != "" && double.TryParse(display, out double num))
        {
            double calcResult = currentOperator switch
            {
                "+" => result + num,
                "-" => result - num,
                "*" => result * num,
                "/" => result / num,
                _ => result
            };
            display = calcResult.ToString();
            result = calcResult;
            currentOperator = "";
            operatorPressed = true;
        }
    }

    private void Clear()
    {
        display = "0";
        result = 0;
        currentOperator = "";
        operatorPressed = false;
    }

    private string GetButtonClass(string type = "number")
    {
        var baseClass = "p-4 border-none rounded-md cursor-pointer font-semibold text-lg transition-colors";

        return type switch
        {
            "operator" => $"{baseClass} bg-amber-600 hover:bg-amber-700 text-white",
            "equals" => $"{baseClass} bg-green-600 hover:bg-green-700 text-white",
            "clear" => $"{baseClass} bg-red-600 hover:bg-red-700 text-white",
            _ => $"{baseClass} bg-zinc-700 hover:bg-zinc-600 text-white"
        };
    }
}
