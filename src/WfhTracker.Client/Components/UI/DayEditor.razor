@inject EntryService entryService

<div>
    <h2 class="mb-6 text-sm font-semibold text-white">
        @SelectedDate.ToString("dddd, MMMM d, yyyy")
    </h2>

    <div class="flex flex-col gap-4">
        <div>
            <label class="mb-2 block text-sm font-medium text-zinc-400">
                Hours
            </label>
            <input type="number" @bind="hours" min="0" max="24" step="0.5" class="w-full rounded-md border border-zinc-600 bg-zinc-700 px-3 py-2 text-white focus:border-amber-600 focus:outline-none" />
        </div>

        <div class="flex gap-2">
            <button @onclick="SaveEntry" disabled="@isSaving" class="flex-1 rounded-md bg-amber-600 px-4 py-2 font-medium text-white transition-colors hover:bg-amber-700 disabled:cursor-not-allowed disabled:opacity-50">
                @(isSaving ? (currentEntry != null ? "Updating..." : "Saving...") : (currentEntry != null ? "Update" : "Add Entry"))
            </button>
            <button @onclick="DeleteEntry" disabled="@IsDeleteDisabled" class="flex-1 rounded-md bg-red-600 px-4 py-2 font-medium text-white transition-colors hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-50">
                @(isDeleting ? "Deleting..." : "Delete")
            </button>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="rounded-md bg-red-900 p-2 text-sm text-red-200">
                @errorMessage
            </div>
        }
    </div>
</div>