<div>
    <!-- Header with month/year and navigation -->
    <div class="mb-6 flex items-center justify-between">
        <button @onclick="PreviousMonth" 
                class="rounded bg-zinc-700 px-2 py-1 text-zinc-400 transition hover:bg-zinc-600 hover:text-white">
            <BackIcon class="h-4 w-4" />
        </button>

        <h2 class="text-lg m-0 flex-1 text-center font-semibold text-white">
            @CurrentMonth.ToString("MMMM yyyy")
        </h2>

        <button @onclick="NextMonth" 
                class="rounded bg-zinc-700 px-2 py-1 text-zinc-400 transition hover:bg-zinc-600 hover:text-white">
            <NextIcon class="h-4 w-4" />
        </button>
    </div>

    <!-- Day headers -->
    <div class="mb-2 grid grid-cols-7 gap-2">
        @foreach (var day in CalendarConstants.DayNames)
        {
            <div class="text-center text-xs font-semibold text-amber-600">
                @day
            </div>
        }
    </div>

    <!-- Calendar grid -->
    <div class="grid flex-1 grid-cols-7 gap-2">
        @foreach (var date in GetCalendarDays())
        {
            <div>
                <div class="@GetDayClass(date)"
                     @onclick="async () => await HandleDateSelect(date)">
                    <span class="absolute top-1 left-1 text-xs md:text-sm lg:text-lg">@date.Day</span>
                    @if (HasEntry(date))
                    {
                        <div class="absolute right-1 bottom-1 flex items-center justify-center">
                            <HomeIcon class="h-4 w-4 text-amber-500 sm:h-5 sm:w-5 md:h-6 md:w-6 lg:h-7 lg:w-7" />
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>



