@page "/"

@inject EntryService entryService

@attribute [Authorize]

<PageTitle>WFH Tracker</PageTitle>

@if (isLoading)
{
    <LoadingSpinner />
}
else
{
    <div class="mx-auto w-full max-w-7xl px-2 sm:px-4 md:px-6">
        <div class="mb-6">
            <h1 class="text-2xl font-semibold text-white">Track Your Work-From-Home Hours</h1>
        </div>

        @if (entries.Count == 0)
        {
            <div class="rounded-lg border border-zinc-700 bg-zinc-900 p-8 text-center">
                <div class="mb-4 text-4xl text-zinc-500">📅</div>
                <h2 class="mb-2 text-lg font-medium text-white">No entries yet</h2>
                <p class="text-sm text-zinc-400">Select a date on the calendar and enter your hours to get started.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
                <div class="col-span-1 rounded-lg bg-zinc-900 p-6 shadow-lg md:col-span-2">
                    <Calendar Entries="@entries" OnDateSelected="@HandleDateSelected" />
                </div>
                <div class="col-span-1 rounded-lg bg-zinc-900 p-6 shadow-lg">
                    <DayEditor OnEntryModified="@HandleEntryModified" SelectedDate="@selectedDate" />
                </div>

                <div class="col-span-1 rounded-lg bg-zinc-900 p-6 shadow-lg">
                    <Calculator />
                </div>
            </div>
        }
    </div>        
}
