{
  "name": "wfhtracker.client",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "npx @tailwindcss/cli -i ./Styles/input.css -o ./wwwroot/css/output.css",
    "watch:css": "npx @tailwindcss/cli -i ./Styles/input.css -o ./wwwroot/css/output.css --watch"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
